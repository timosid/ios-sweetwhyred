--- a/iokit/Kernel/arm/SweetFramebufferBlit.h
+++ b/iokit/Kernel/arm/SweetFramebufferBlit.h
@@ -29,6 +29,40 @@
 	uint64_t end = (uint64_t)image->offset +
 	    (uint64_t)(image->height - 1) * image->row_bytes + (uint64_t)image->width * 4;
 	return end <= image->length;
+}
+
+/* Inspect visible pixels only: padding and allocation tails are not image data. */
+struct sweet_fb_content {
+	uint64_t pixels, rgb_pixels, alpha_pixels;
+	uint32_t min_x, min_y, max_x, max_y; /* exclusive maximum; zero for black */
+};
+
+static inline struct sweet_fb_content
+sweet_fb_measure(const struct sweet_fb_image *image)
+{
+	struct sweet_fb_content result = {0, 0, 0, 0, 0, 0, 0};
+	if (!sweet_fb_image_valid(image)) return result;
+	result.pixels = (uint64_t)image->width * image->height;
+	for (uint32_t y = 0; y < image->height; y++) {
+		const uint8_t *row = image->pixels + image->offset + (uint64_t)y * image->row_bytes;
+		for (uint32_t x = 0; x < image->width; x++) {
+			uint32_t pixel;
+			/* One visible pixel read, including unaligned caller offsets. */
+			__builtin_memcpy(&pixel, row + (uint64_t)x * 4, sizeof(pixel));
+			if (pixel & 0xff000000u) result.alpha_pixels++;
+			if ((pixel & 0x00ffffffu) == 0) continue;
+			if (result.rgb_pixels++ == 0) {
+				result.min_x = x; result.min_y = y;
+				result.max_x = x + 1; result.max_y = y + 1;
+			} else {
+				if (x < result.min_x) result.min_x = x;
+				if (y < result.min_y) result.min_y = y;
+				if (x >= result.max_x) result.max_x = x + 1;
+				if (y >= result.max_y) result.max_y = y + 1;
+			}
+		}
+	}
+	return result;
 }
 

+#if defined(SWEET)
+static bool
+whyred_idle_wait_pending(void)
+{
+	/* Idle_context runs on CPU_ISTACKPTR. An IRQ handler resets SP to
+	 * that same top, so it must not execute until Idle_load_context has
+	 * restored the thread stack. WFI wakes for a pending GIC IRQ with
+	 * PSTATE.I set; WFE is not required to treat that as an event.
+	 * Keep the existing GIC priority/group enables and DAIF mask intact.
+	 */
+	assert(!ml_get_interrupts_enabled());
+	while (!cpu_interrupt_is_pending()) {
+		__builtin_arm_dsb(DSB_SY);
+		__builtin_arm_wfi();
+	}
+	return true;
+}
+#endif

--- /dev/null
+++ b/bsd/kern/whyred_service_trace.h
@@ -0,0 +1,44 @@
+#ifndef WHYRED_SERVICE_TRACE_H
+#define WHYRED_SERVICE_TRACE_H
+
+#include <os/atomic_private.h>
+
+enum {
+	WHYRED_SERVICE_EXEC,
+	WHYRED_SERVICE_SPAWN,
+	WHYRED_SERVICE_EXIT,
+	WHYRED_SERVICE_EVENTS
+};
+
+/* Called with a live process reference, outside proc locks. No allocations,
+ * user-memory accesses, path lookup, reason-buffer parsing or policy changes.
+ * Each translation unit has its own fixed counters. kern_exec emits exec/spawn,
+ * kern_exit emits exit: at most 5 targets * 3 events * 64 records per boot.
+ */
+static void
+whyred_service_event(proc_t p, unsigned int event, int error, int detail,
+    int status, uint32_t reason_namespace, uint64_t reason_code)
+{
+	static const char *const names[] = { "bluetoothd", "fairplayd.H2", "suggestd", "lsd", "pkd" };
+	static const char *const events[] = { "exec", "spawn", "exit" };
+	static uint32_t reports[5][WHYRED_SERVICE_EVENTS];
+	uint32_t enabled = 0;
+	if (p == PROC_NULL || event >= WHYRED_SERVICE_EVENTS ||
+	    !PE_parse_boot_argn("whyred-service-trace", &enabled, sizeof(enabled)) || enabled != 1) return;
+	unsigned int target;
+	for (target = 0; target < 5; target++) {
+		if (strcmp(p->p_name, names[target]) == 0) break;
+	}
+	if (target == 5) return;
+	uint32_t n = os_atomic_load(&reports[target][event], relaxed);
+	for (;;) {
+		if (n >= 64) return;
+		if (os_atomic_cmpxchg(&reports[target][event], n, n + 1, relaxed)) break;
+		n = os_atomic_load(&reports[target][event], relaxed);
+	}
+	printf("WHYRED SERVICE: ticks=%llu name=%s pid=%d event=%s seq=%u error=%d detail=%d status=0x%x reason=%u/0x%llx\n",
+	    mach_absolute_time(), names[target], proc_getpid(p), events[event], n + 1,
+	    error, detail, (unsigned int)status, reason_namespace, reason_code);
+}
+
+#endif

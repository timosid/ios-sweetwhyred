+/* whyred SDM636/SDM660 USB2 handoff. No PMIC, PLL, reset or SMMU programming.
+ * Register provenance: MiCode whyred-o-oss efbbb9cce47475c49f28d227b2a52eca6f0d02a7
+ * gcc-sdm660.c, phy-msm-qusb.c, dwc3-msm.c and the saved board device tree.
+ * This first port requires the bootloader's powered, locked QUSB2 PHY.
+ */
+#ifndef WHYRED_USB_HW_H
+#define WHYRED_USB_HW_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define WHYRED_USB_GCC_PA 0x00100000u
+#define WHYRED_USB_GCC_SIZE 0x00090000u
+#define WHYRED_USB_GDSCR 0x0f004u
+#define WHYRED_USB_BCR 0x0f000u
+#define WHYRED_USB_DWC_PA 0x0a800000u
+#define WHYRED_USB_DWC_SIZE 0x0000d000u
+#define WHYRED_USB_PHY_PA 0x0c012000u
+#define WHYRED_USB_PHY_SIZE 0x180u
+#define WHYRED_USB_QS_PA 0x0a8f8800u
+#define WHYRED_USB_QS_SIZE 0x100u
+#define WHYRED_USB_CLK_OFF (1u << 31)
+#define WHYRED_USB_PLL_LOCK (1u << 5)
+#define WHYRED_USB_PHY_POWERDOWN 0xb4u
+#define WHYRED_USB_PHY_PLL_STATUS 0x38u
+#define WHYRED_USB_CLOCKS 6u
+#define WHYRED_USB_CLOCK_POLLS 1000u
+
+static const uint32_t whyred_usb_clocks[WHYRED_USB_CLOCKS] = {
+    0xf008, 0xf00c, 0xf010, 0x05018, 0xf03c, 0x6a004
+}; /* master, sleep, UTMI, cfg-NoC, aggre2, AHB2PHY */
+
+struct whyred_usb_io {
+    void *context;
+    uintptr_t (*map)(void *, uintptr_t, size_t);
+    uint32_t (*read)(void *, uintptr_t, uint32_t);
+    void (*write)(void *, uintptr_t, uint32_t, uint32_t);
+    void (*delay_us)(void *, unsigned int);
+};
+
+enum whyred_usb_hw_status {
+    WHYRED_USB_HW_OK = 0, WHYRED_USB_HW_OFF, WHYRED_USB_HW_MAP,
+    WHYRED_USB_HW_POWER, WHYRED_USB_HW_RESET, WHYRED_USB_HW_CLOCK,
+    WHYRED_USB_HW_PHY, WHYRED_USB_HW_CORE
+};
+
+struct whyred_usb_hw {
+    uintptr_t gcc, dwc, phy, qs;
+    uint32_t gdscr, reset, clocks[WHYRED_USB_CLOCKS], changed_clocks, sampled_clocks;
+    uint32_t ref_gate, ref_vote, phy_power, phy_pll, id, gctl, phy_cfg;
+};
+
+/* Only undo branch enable bits introduced by this attempt, before DMA starts. */
+static void
+whyred_usb_hw_rollback(const struct whyred_usb_io *io, struct whyred_usb_hw *hw)
+{
+    for (unsigned int i = WHYRED_USB_CLOCKS; i-- > 0;) {
+        if (hw->changed_clocks & (1u << i)) {
+            uint32_t value = io->read(io->context, hw->gcc, whyred_usb_clocks[i]);
+            io->write(io->context, hw->gcc, whyred_usb_clocks[i], value & ~1u);
+        }
+    }
+    hw->changed_clocks = 0;
+}
+
+/* 0/invalid: no MMIO; 1: read-only snapshot; 2: bounded branch votes + handoff.
+ * Never access the DWC3/PHY while the domain is off, reset asserted or bus gated.
+ */
+static enum whyred_usb_hw_status
+whyred_usb_hw_prepare(const struct whyred_usb_io *io, int mode, struct whyred_usb_hw *hw)
+{
+    *hw = (struct whyred_usb_hw){0};
+    if (mode != 1 && mode != 2) return WHYRED_USB_HW_OFF;
+    hw->gcc = io->map(io->context, WHYRED_USB_GCC_PA, WHYRED_USB_GCC_SIZE);
+    if (!hw->gcc) return WHYRED_USB_HW_MAP;
+    hw->gdscr = io->read(io->context, hw->gcc, WHYRED_USB_GDSCR);
+    hw->reset = io->read(io->context, hw->gcc, WHYRED_USB_BCR);
+    if (!(hw->gdscr & (1u << 31))) return WHYRED_USB_HW_POWER;
+    if (hw->reset & 1u) return WHYRED_USB_HW_RESET;
+    for (unsigned int i = 0; i < WHYRED_USB_CLOCKS; i++) {
+        uint32_t value = io->read(io->context, hw->gcc, whyred_usb_clocks[i]);
+        hw->clocks[i] = value;
+        hw->sampled_clocks |= 1u << i;
+        if (!(value & WHYRED_USB_CLK_OFF)) continue;
+        if (mode != 2) return WHYRED_USB_HW_CLOCK;
+        if (!(value & 1u)) {
+            io->write(io->context, hw->gcc, whyred_usb_clocks[i], value | 1u);
+            hw->changed_clocks |= 1u << i;
+        }
+        unsigned int poll;
+        for (poll = 0; poll < WHYRED_USB_CLOCK_POLLS; poll++) {
+            hw->clocks[i] = io->read(io->context, hw->gcc, whyred_usb_clocks[i]);
+            if (!(hw->clocks[i] & WHYRED_USB_CLK_OFF)) break;
+            io->delay_us(io->context, 1);
+        }
+        if (poll == WHYRED_USB_CLOCK_POLLS) {
+            whyred_usb_hw_rollback(io, hw);
+            return WHYRED_USB_HW_CLOCK;
+        }
+    }
+    hw->ref_gate = io->read(io->context, hw->gcc, 0x88018);
+    hw->ref_vote = io->read(io->context, hw->gcc, 0x88014);
+    hw->phy = io->map(io->context, WHYRED_USB_PHY_PA, WHYRED_USB_PHY_SIZE);
+    if (!hw->phy) goto map_error;
+    hw->phy_power = io->read(io->context, hw->phy, WHYRED_USB_PHY_POWERDOWN);
+    hw->phy_pll = io->read(io->context, hw->phy, WHYRED_USB_PHY_PLL_STATUS);
+    if ((hw->phy_power & 0x23u) != 0x22u || !(hw->phy_pll & WHYRED_USB_PLL_LOCK)) {
+        whyred_usb_hw_rollback(io, hw);
+        return WHYRED_USB_HW_PHY;
+    }
+    hw->dwc = io->map(io->context, WHYRED_USB_DWC_PA, WHYRED_USB_DWC_SIZE);
+    if (!hw->dwc) goto map_error;
+    hw->id = io->read(io->context, hw->dwc, 0xc120);
+    if ((hw->id >> 16) != 0x5533u) {
+        whyred_usb_hw_rollback(io, hw);
+        return WHYRED_USB_HW_CORE;
+    }
+    hw->gctl = io->read(io->context, hw->dwc, 0xc110);
+    hw->phy_cfg = io->read(io->context, hw->dwc, 0xc200);
+    if ((hw->gctl & (1u << 11)) || (hw->phy_cfg & (1u << 31))) {
+        whyred_usb_hw_rollback(io, hw);
+        return WHYRED_USB_HW_CORE;
+    }
+    hw->qs = io->map(io->context, WHYRED_USB_QS_PA, WHYRED_USB_QS_SIZE);
+    if (!hw->qs) goto map_error;
+    return WHYRED_USB_HW_OK;
+map_error:
+    whyred_usb_hw_rollback(io, hw);
+    return WHYRED_USB_HW_MAP;
+}
+
+/* Exact high/full-speed-only PIPE mux sequence from SDM660 dwc3-msm.c.
+ * Use the already running UTMI clock, without touching QMP/PHY or PLL registers.
+ */
+static bool
+whyred_usb_hw_select_utmi(const struct whyred_usb_io *io, struct whyred_usb_hw *hw)
+{
+    uint32_t before = io->read(io->context, hw->qs, 0x08);
+    io->write(io->context, hw->qs, 0x08, before | (1u << 8));
+    io->delay_us(io->context, 5);
+    uint32_t value = io->read(io->context, hw->qs, 0x08);
+    io->write(io->context, hw->qs, 0x08, value | 1u | (1u << 3));
+    io->delay_us(io->context, 5);
+    value = io->read(io->context, hw->qs, 0x08);
+    io->write(io->context, hw->qs, 0x08, value & ~(1u << 8));
+    value = io->read(io->context, hw->qs, 0x08);
+    if ((value & ((1u << 8) | 1u | (1u << 3))) == (1u | (1u << 3))) return true;
+    /* Restore only the owned mux bits if readback refused the change. */
+    uint32_t mask = (1u << 8) | 1u | (1u << 3);
+    io->write(io->context, hw->qs, 0x08, (value & ~mask) | (before & mask));
+    return false;
+}

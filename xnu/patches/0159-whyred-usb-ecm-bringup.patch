+static uint32_t
+ud_configuration(uint8_t *out, bool other_speed)
+{
+	uint16_t packet = ud.max_packet;
+	if (packet != 64 && packet != 512) return 0;
+	if (other_speed) packet = packet == 512 ? 64 : 512;
+	memcpy(out, ud_cfg_desc, sizeof(ud_cfg_desc));
+	if (other_speed) out[1] = 7;
+	for (uint32_t at = 0; at + 2 <= sizeof(ud_cfg_desc);) {
+		uint32_t length = out[at];
+		if (length < 2 || length > sizeof(ud_cfg_desc) - at) return 0;
+		if (out[at + 1] == 5 && length == 7 && (out[at + 3] & 3) == 2) {
+			out[at + 4] = (uint8_t)packet;
+			out[at + 5] = (uint8_t)(packet >> 8);
+		}
+		at += length;
+	}
+	return sizeof(ud_cfg_desc);
+}

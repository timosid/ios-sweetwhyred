+/* Called under rm_lock. Sampling and storage are bounded and allocation-free. */
+static void
+ramfs_pressure_record_locked(struct ramfs_node *node, enum ramfs_pressure_reason reason,
+    uint64_t off, uint64_t length)
+{
+	struct ramfs_mount *rm = node->rn_mount;
+	struct ramfs_pressure_event *e = &rm->rm_event;
+	if (!rm->rm_trace) return;
+	rm->rm_failures[reason]++;
+	uint64_t seq = ++rm->rm_failure_seq;
+	e->valid = false;
+	if (rm->rm_reports >= 32 || (seq > 16 && (seq & (seq - 1)) != 0)) return;
+	*e = (struct ramfs_pressure_event){ .valid = true, .reason = reason, .seq = seq,
+	    .ino = node->rn_ino, .off = off, .length = length, .pages = rm->rm_pages,
+	    .limit = rm->rm_max_pages, .peak = rm->rm_peak, .nodes = rm->rm_nodes,
+	    .xattr_bytes = rm->rm_xattr_bytes, .added = rm->rm_added, .freed = rm->rm_freed,
+	    .reclaimed = rm->rm_reclaimed };
+	memcpy(e->failures, rm->rm_failures, sizeof(e->failures));
+	/* The mount snapshot is coherent; global VM counts are approximate samples. */
+	e->vm_free = os_atomic_load(&vm_page_free_count, relaxed);
+	e->vm_wired = os_atomic_load(&vm_page_wire_count, relaxed);
+	for (unsigned int i = 0; i < RAMFS_HASH_SIZE; i++) {
+		for (struct ramfs_node *n = rm->rm_hash[i]; n != NULL; n = n->rn_hnext) {
+			e->hash_pages += n->rn_nalloc;
+			if (n->rn_nlink == 0) {
+				e->unlinked_pages += n->rn_nalloc;
+				e->unlinked_nodes++;
+			}
+		}
+	}
+	rm->rm_reports++;
+}
+
+/* Copy before releasing the same lock as the failed operation. */
+static void
+ramfs_pressure_take_locked(struct ramfs_mount *rm, struct ramfs_pressure_event *event)
+{
+	if (rm->rm_trace && rm->rm_event.valid) {
+		*event = rm->rm_event;
+		rm->rm_event.valid = false;
+	}
+}
+
+/* No mount lock, allocation, user copy, path lookup or vnode reference here. */
+static void
+ramfs_pressure_emit(const struct ramfs_pressure_event *e)
+{
+	static const char *const names[] = { "data-quota", "data-page", "slots-nowait",
+	    "getxattr-nowait", "listxattr-nowait" };
+	if (!e->valid) return;
+#define RP64(v) ((unsigned long long)(v))
+	printf("WHYRED RAMFS PRESSURE id=%llu cause=%s ino=%llu off=%llu length=%llu kr=%d\n",
+	    RP64(e->seq), names[e->reason], RP64(e->ino), RP64(e->off), RP64(e->length), e->allocation_error);
+	printf("WHYRED RAMFS PRESSURE id=%llu pages=%llu limit=%llu peak=%llu nodes=%llu xattr_bytes=%llu hash_pages=%llu unlinked_pages=%llu unlinked_nodes=%llu\n",
+	    RP64(e->seq), RP64(e->pages), RP64(e->limit), RP64(e->peak), RP64(e->nodes),
+	    RP64(e->xattr_bytes), RP64(e->hash_pages), RP64(e->unlinked_pages), RP64(e->unlinked_nodes));
+	printf("WHYRED RAMFS PRESSURE id=%llu added=%llu freed=%llu reclaimed=%llu vm_free_sample=%u vm_wired_sample=%u quota=%llu page=%llu slots=%llu getxattr=%llu listxattr=%llu\n",
+	    RP64(e->seq), RP64(e->added), RP64(e->freed), RP64(e->reclaimed), e->vm_free, e->vm_wired,
+	    RP64(e->failures[0]), RP64(e->failures[1]), RP64(e->failures[2]),
+	    RP64(e->failures[3]), RP64(e->failures[4]));
+#undef RP64
+}

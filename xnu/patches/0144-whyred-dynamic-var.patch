+	case _PC_CASE_SENSITIVE:
+	case _PC_CASE_PRESERVING:
+		*ap->a_retval = 1;
+		return 0;
+	case _PC_FILESIZEBITS:
+		*ap->a_retval = 64;
+		return 0;
+	default:
+		return EINVAL;
+	}

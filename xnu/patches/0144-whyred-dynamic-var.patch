Subject: [PATCH] whyred: bounded dynamically allocated var before PID 1

diff --git a/bsd/conf/Makefile.arm64 b/bsd/conf/Makefile.arm64
--- a/bsd/conf/Makefile.arm64
+++ b/bsd/conf/Makefile.arm64
@@ -18,3 +18,5 @@
 apfs_zbitmap.o_CFLAGS_ADD += -mgeneral-regs-only
 apfs_vfsops.o_CFLAGS_ADD += -mgeneral-regs-only
 apfs_vnops.o_CFLAGS_ADD += -mgeneral-regs-only
+
+ramfs.o_CFLAGS_ADD += -mgeneral-regs-only
diff --git a/bsd/conf/files b/bsd/conf/files
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -657,3 +657,5 @@
 bsd/miscfs/apfs/apfs_zbitmap.c	optional whyred_apfs
 bsd/miscfs/apfs/apfs_vfsops.c	optional whyred_apfs
 bsd/miscfs/apfs/apfs_vnops.c	optional whyred_apfs
+
+bsd/miscfs/whyred_ramfs/ramfs.c	optional whyred_ramfs
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1130,6 +1130,21 @@
 #endif
 
 #if defined(SWEET)
+#if WHYRED_RAMFS
+    uint32_t whyred_var_ramfs = 0;
+    if (PE_parse_boot_argn("whyred-var-ramfs", &whyred_var_ramfs,
+        sizeof(whyred_var_ramfs)) && whyred_var_ramfs == 1) {
+        uint32_t legacy_md0 = 0;
+        PE_parse_boot_argn("whyred-var-md0", &legacy_md0, sizeof(legacy_md0));
+        if (legacy_md0) panic("WHYRED VAR: conflicting RAM var selectors");
+        printf("WHYRED VAR: mounting dynamic RAMFS before PID 1\n");
+        int error = kernel_mount("whyredramfs", NULLVP, NULLVP,
+            "/private/var", NULL, 0, MNT_DONTBROWSE,
+            KERNEL_MOUNT_NOAUTH, vfs_context_kernel());
+        if (error) panic("WHYRED VAR: RAMFS mount failed: %d", error);
+        printf("WHYRED VAR: seeded dynamic RAMFS ready\n");
+    }
+#endif
 	/* Mount /var before cloning PID 1, while copyin uses the kernel map. */
 	uint32_t whyred_var_md0 = 0;
 	if (PE_parse_boot_argn("whyred-var-md0", &whyred_var_md0,

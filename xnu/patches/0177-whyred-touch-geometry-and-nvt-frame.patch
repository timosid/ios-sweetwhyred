+/* Transport adapter for a CONFIRMED Novatek controller only. The payload
+ * excludes the I2C register prefix. No MMIO, probing or controller selection. */
+bool
+SweetHIDTouch::novatekFrame(const uint8_t *bytes, size_t length)
+{
+	struct whyred_touch_frame frame;
+	if (!fWhyred || whyred_touch_decode_nvt(bytes, length, &frame)) {
+		return false;
+	}
+	for (unsigned i = 0; i < 10; ++i) {
+		touch(i, (frame.active & (1u << i)) != 0, frame.x[i], frame.y[i]);
+	}
+	return true;
+}
+
+extern "C" int
+whyred_hid_novatek_frame(const uint8_t *bytes, size_t length)
+{
+	return gSweetTouch && gSweetTouch->novatekFrame(bytes, length) ? 0 : -1;
+}

--- /dev/null
+++ b/iokit/Kernel/arm/hid/WhyredTouch.h
@@ -0,0 +1,48 @@
+/* Whyred CPU digitizer geometry and bounded Novatek event decoding.
+ * Clean implementation from Xiaomi whyred-o-oss nvt_touch packet layout.
+ * This does not select an IC, power rails, configure pins or access I2C.
+ */
+#ifndef WHYRED_TOUCH_H
+#define WHYRED_TOUCH_H
+struct whyred_touch_frame {
+	unsigned active;
+	int x[10], y[10];
+};
+
+static inline int
+whyred_touch_axis(int value, int extent)
+{
+	if (extent <= 0) return 0;
+	if (value < 0) value = 0;
+	if (value >= extent) value = extent - 1;
+	return (int)(((int64_t)value << 16) / extent);
+}
+
+/* Exactly65 wire bytes after the register prefix; decode atomically. Keep
+ * caller output intact on truncation, recovery patterns or malformed contacts. */
+static inline int
+whyred_touch_decode_nvt(const uint8_t *bytes, size_t length,
+    struct whyred_touch_frame *out)
+{
+	struct whyred_touch_frame frame = {0, {0}, {0}};
+	if (!bytes || !out || length != 65) return -1;
+	unsigned recovery = 0, erased = 0;
+	for (unsigned i = 0; i < 6; ++i) recovery += bytes[i] == 0x77;
+	for (unsigned i = 0; i < 65; ++i) erased += bytes[i] == 0xff;
+	if (recovery == 6 || erased == 65) return -1;
+	for (unsigned i = 0; i < 10; ++i) {
+		const uint8_t *p = bytes + i * 6;
+		unsigned state = p[0] & 7, id = p[0] >> 3;
+		if (state != 1 && state != 2) continue;
+		if (!id || id > 10 || (frame.active & (1u << (id - 1)))) return -1;
+		int x = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		int y = ((unsigned)p[2] << 4) | (p[3] & 15);
+		if (x > 1080 || y > 2160) return -1;
+		frame.active |= 1u << (id - 1);
+		frame.x[id - 1] = x == 1080 ? 1079 : x;
+		frame.y[id - 1] = y == 2160 ? 2159 : y;
+	}
+	*out = frame;
+	return 0;
+}
+#endif

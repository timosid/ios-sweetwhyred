+static int
+whyred_emmc_reset_data_path(volatile uint8_t *base)
+{
+	uint64_t timeout = whyred_emmc_timeout_ticks();
+	uint64_t start;
+	uint32_t pending;
+	uint32_t present;
+	if (timeout == 0) {
+		printf("WHYRED EMMC: DATA reset skipped; CNTFRQ is zero\n");
+		return -1;
+	}
+	whyred_emmc_write8(base, SDHCI_SOFTWARE_RESET, SDHCI_RESET_DATA);
+	start = whyred_emmc_counter();
+	while ((whyred_emmc_read8(base, SDHCI_SOFTWARE_RESET) &
+	    SDHCI_RESET_DATA) != 0) {
+		if ((whyred_emmc_counter() - start) >= timeout) {
+			printf("WHYRED EMMC: DATA reset timeout reset=0x%02x\n",
+			    whyred_emmc_read8(base, SDHCI_SOFTWARE_RESET));
+			return -1;
+		}
+	}
+	pending = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+	if (pending != 0) {
+		whyred_emmc_write32(base, SDHCI_INT_STATUS, pending);
+	}
+	present = whyred_emmc_read32(base, SDHCI_PRESENT_STATE);
+	pending = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+	if (pending != 0 || (present & (SDHCI_PSTATE_CMD_INHIBIT |
+	    SDHCI_PSTATE_DATA_INHIBIT | SDHCI_PSTATE_DATA_AVAILABLE)) != 0) {
+		printf("WHYRED EMMC: DATA reset left host busy int=0x%08x present=0x%08x\n",
+		    pending, present);
+		return -1;
+	}
+	printf("WHYRED EMMC: DATA reset complete int=0x%08x present=0x%08x\n",
+	    pending, present);
+	return 0;
+}

 /* Diagnostic names only: bounded printable ASCII, never file content. */
+/* A development policy for the confirmed System v70 _logd UID. It bounds
+ * each regular file, not aggregate UID use. No existing data is removed.
+ */
+static uint64_t
+ramfs_logd_limit_from_arg(uint32_t mib, uint64_t max_pages)
+{
+	if (mib < 1 || mib > 64) return 0;
+	return MIN((uint64_t)mib * 1024 * 1024 / PAGE_SIZE, max_pages) * PAGE_SIZE;
+}
+
+static uint64_t
+ramfs_file_limit(struct ramfs_mount *rm, uid_t uid)
+{
+	uint64_t limit = rm->rm_max_pages * PAGE_SIZE;
+	if (uid == WHYRED_RAMFS_LOGD_UID && rm->rm_logd_file_limit) {
+		limit = MIN(limit, rm->rm_logd_file_limit);
+	}
+	return limit;
+}

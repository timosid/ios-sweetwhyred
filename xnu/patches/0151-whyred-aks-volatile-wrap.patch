new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetKeyStoreWrap.h
@@ -0,0 +1,75 @@
+/* Development-only whyred AKS: bounded RFC 3394 AES key wrap.
+ * AES itself is supplied by XNU's existing constant-time SWEET provider.
+ * The callback operates on exactly one 16-byte block and returns 0 on success.
+ * Unwrap never copies unauthenticated plaintext to its output.
+ */
+#ifndef SWEET_KEYSTORE_WRAP_H
+#define SWEET_KEYSTORE_WRAP_H
+#include <stdint.h>
+
+#define SWEET_AKS_MAX_KEY_BYTES 64u
+#define SWEET_AKS_MAX_WRAPPED_BYTES (SWEET_AKS_MAX_KEY_BYTES + 8u)
+
+typedef int (*sweet_aks_block_fn)(void *, const uint8_t *, uint8_t *);
+enum { SWEET_KW_OK = 0, SWEET_KW_ARGUMENT = -1,
+       SWEET_KW_NOSPACE = -2, SWEET_KW_CRYPTO = -3, SWEET_KW_INTEGRITY = -4 };
+
+static void
+sweet_aks_clear(void *p, uint32_t n)
+{
+	volatile uint8_t *v = (volatile uint8_t *)p;
+	while (n-- != 0) *v++ = 0;
+}
+
+static int
+sweet_aks_kw(int unwrap, sweet_aks_block_fn block, void *ctx,
+    const uint8_t *input, uint32_t input_len, uint8_t *output,
+    uint32_t capacity, uint32_t *output_len)
+{
+	uint8_t work[SWEET_AKS_MAX_WRAPPED_BYTES], b[16];
+	uint32_t plain_len, result_len, n;
+	int ret = SWEET_KW_ARGUMENT;
+	if (output_len == 0) return ret;
+	*output_len = 0;
+	if (block == 0 || ctx == 0 || input == 0 || output == 0 ||
+	    (unwrap != 0 && unwrap != 1)) return ret;
+	if ((input_len & 7u) != 0 ||
+	    input_len < (unwrap ? 24u : 16u) ||
+	    input_len > (unwrap ? SWEET_AKS_MAX_WRAPPED_BYTES : SWEET_AKS_MAX_KEY_BYTES)) return ret;
+	plain_len = unwrap ? input_len - 8u : input_len;
+	result_len = unwrap ? plain_len : plain_len + 8u;
+	if (capacity < result_len) return SWEET_KW_NOSPACE;
+	n = plain_len / 8u;
+	for (uint32_t k = 0; k < 8u; k++) work[k] = unwrap ? input[k] : 0xa6;
+	for (uint32_t k = 0; k < plain_len; k++) work[k + 8u] = input[k + (unwrap ? 8u : 0u)];
+	for (int j = unwrap ? 5 : 0; unwrap ? j >= 0 : j < 6; unwrap ? j-- : j++) {
+		for (uint32_t step = 0; step < n; step++) {
+			uint32_t i = unwrap ? n - step : step + 1u;
+			uint64_t t = (uint64_t)n * (uint32_t)j + i;
+			for (uint32_t k = 0; k < 8u; k++) {
+				b[k] = work[k];
+				b[k + 8u] = work[i * 8u + k];
+			}
+			if (unwrap) for (uint32_t k = 0; k < 8u; k++) b[7u - k] ^= (uint8_t)(t >> (8u * k));
+			if (block(ctx, b, b) != 0) { ret = SWEET_KW_CRYPTO; goto done; }
+			if (!unwrap) for (uint32_t k = 0; k < 8u; k++) b[7u - k] ^= (uint8_t)(t >> (8u * k));
+			for (uint32_t k = 0; k < 8u; k++) {
+				work[k] = b[k];
+				work[i * 8u + k] = b[k + 8u];
+			}
+		}
+	}
+	if (unwrap) {
+		uint8_t difference = 0;
+		for (uint32_t k = 0; k < 8u; k++) difference |= work[k] ^ 0xa6u;
+		if (difference != 0) { ret = SWEET_KW_INTEGRITY; goto done; }
+	}
+	for (uint32_t k = 0; k < result_len; k++) output[k] = work[k + (unwrap ? 8u : 0u)];
+	*output_len = result_len;
+	ret = SWEET_KW_OK;
+done:
+	sweet_aks_clear(b, sizeof(b));
+	sweet_aks_clear(work, sizeof(work));
+	return ret;
+}
+#endif

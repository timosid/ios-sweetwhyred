+/* Exact 20F66 libaks ABI: [bag handle, class], wrap returns actualClass;
+ * unwrap has no scalar outputs. This format is local to this volatile boot.
+ */
+static IOReturn
+whyred_aks_wrap(AppleKeyStore *store, IOExternalMethodArguments *args, bool unwrap)
+{
+	uint8_t input[SWEET_AKS_MAX_WRAPPED_BYTES], output[SWEET_AKS_MAX_WRAPPED_BYTES];
+	aes_ctx context;
+	uint32_t output_len = 0;
+	uint64_t input_len = args->structureInputDescriptor != NULL ?
+	    args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint64_t capacity = args->structureOutputDescriptor != NULL ?
+	    args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+	uint32_t scalar_capacity = args->scalarOutputCount;
+	IOReturn ret = kIOReturnBadArgument;
+	const uint8_t *kek = NULL;
+
+	/* No output length or actualClass is reported on any failing call. */
+	args->scalarOutputCount = 0;
+	args->structureOutputSize = 0;
+	args->structureOutputDescriptorSize = 0;
+	if (store != NULL && !store->volatileWrapEnabled()) {
+		ret = kIOReturnUnsupported;
+		goto done;
+	}
+	if (store == NULL || args->scalarInputCount != 2 || args->scalarInput == NULL ||
+	    scalar_capacity != (unwrap ? 0u : 1u) ||
+	    (!unwrap && args->scalarOutput == NULL) ||
+	    args->scalarInput[0] != SWEET_AKS_SYSTEM_HANDLE ||
+	    args->scalarInput[1] > 12 ||
+	    (kek = store->wrapKey((uint32_t)args->scalarInput[1])) == NULL ||
+	    input_len < (unwrap ? 24u : 16u) || (input_len & 7u) != 0 ||
+	    input_len > (unwrap ? SWEET_AKS_MAX_WRAPPED_BYTES : SWEET_AKS_MAX_KEY_BYTES)) {
+		goto done;
+	}
+	if (capacity < (unwrap ? input_len - 8u : input_len + 8u)) {
+		ret = kIOReturnNoSpace;
+		goto done;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput == NULL) goto done;
+	if (args->structureInputDescriptor != NULL) {
+		if (args->structureInputDescriptor->readBytes(0, input, input_len) != input_len) {
+			ret = kIOReturnUnderrun;
+			goto done;
+		}
+	} else {
+		if (args->structureInput == NULL) goto done;
+		memcpy(input, args->structureInput, (size_t)input_len);
+	}
+	if ((unwrap ? aes_decrypt_key256(kek, &context.decrypt) :
+	    aes_encrypt_key256(kek, &context.encrypt)) != aes_good) {
+		ret = kIOReturnError;
+		goto done;
+	}
+	{
+		int result = sweet_aks_kw(unwrap, unwrap ? whyred_aks_decrypt : whyred_aks_encrypt,
+		    unwrap ? (void *)&context.decrypt : (void *)&context.encrypt,
+		    input, (uint32_t)input_len, output, sizeof(output), &output_len);
+		if (result != SWEET_KW_OK) {
+			ret = result == SWEET_KW_INTEGRITY ? kIOReturnNotPermitted : kIOReturnError;
+			goto done;
+		}
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		if (args->structureOutputDescriptor->writeBytes(0, output, output_len) != output_len) {
+			ret = kIOReturnUnderrun;
+			goto done;
+		}
+		args->structureOutputDescriptorSize = output_len;
+	} else {
+		memcpy(args->structureOutput, output, output_len);
+		args->structureOutputSize = output_len;
+	}
+	if (!unwrap) {
+		args->scalarOutput[0] = args->scalarInput[1];
+		args->scalarOutputCount = 1;
+	}
+	ret = kIOReturnSuccess;
+done:
+	sweet_aks_clear(&context, sizeof(context));
+	sweet_aks_clear(input, sizeof(input));
+	sweet_aks_clear(output, sizeof(output));
+	return ret;
+}
+#endif

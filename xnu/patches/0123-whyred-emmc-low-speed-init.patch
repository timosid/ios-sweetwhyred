+static void
+whyred_emmc_delay_us(uint32_t usec)
+{
+	uint64_t frequency = __builtin_arm_rsr64("CNTFRQ_EL0");
+	if (frequency == 0) {
+		return;
+	}
+	uint64_t ticks = (frequency * usec) / 1000000;
+	uint64_t start = whyred_emmc_counter();
+	while ((whyred_emmc_counter() - start) < ticks) {
+	}
+}

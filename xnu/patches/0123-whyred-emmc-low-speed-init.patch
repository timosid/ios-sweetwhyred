+static int
+whyred_emmc_set_200khz_clock(volatile uint8_t *base, uint32_t caps,
+	uint32_t *divider_out)
+{
+	uint32_t base_mhz = (caps >> 8) & 0xff;
+	if (base_mhz == 0) {
+		printf("WHYRED EMMC INIT: SDHCI base clock is zero; abort\n");
+		return -1;
+	}
+	uint64_t source_hz = (uint64_t)base_mhz * 1000000;
+	if (source_hz < WHYRED_SDCC1_CLOCK_SOURCE_MAX_HZ) {
+		source_hz = WHYRED_SDCC1_CLOCK_SOURCE_MAX_HZ;
+	}
+	uint32_t divider = (uint32_t)((source_hz +
+	    (2 * WHYRED_EMMC_INIT_CLOCK_HZ - 1)) /
+	    (2 * WHYRED_EMMC_INIT_CLOCK_HZ));
+	if (divider == 0) {
+		divider = 1;
+	}
+	if (divider > 1023) {
+		printf("WHYRED EMMC INIT: 200kHz divider out of range: %u\n",
+		    divider);
+		return -1;
+	}
+
+	uint16_t clock = whyred_emmc_read16(base, SDHCI_CLOCK_CONTROL);
+	clock &= (uint16_t)~(SDHCI_CLOCK_CARD_ENABLE | SDHCI_CLOCK_DIV_MASK |
+	    SDHCI_CLOCK_INT_STABLE);
+	clock |= (uint16_t)(((divider & 0xff) << 8) |
+	    ((divider & 0x300) >> 2) | SDHCI_CLOCK_INT_ENABLE);
+	whyred_emmc_write16(base, SDHCI_CLOCK_CONTROL, clock);
+
+	uint64_t frequency = __builtin_arm_rsr64("CNTFRQ_EL0");
+	if (frequency == 0) {
+		printf("WHYRED EMMC INIT: CNTFRQ is zero while changing clock\n");
+		return -1;
+	}
+	uint64_t timeout = frequency / 10; /* 100 ms */
+	uint64_t start = whyred_emmc_counter();
+	while ((whyred_emmc_read16(base, SDHCI_CLOCK_CONTROL) &
+	    SDHCI_CLOCK_INT_STABLE) == 0) {
+		if ((whyred_emmc_counter() - start) >= timeout) {
+			printf("WHYRED EMMC INIT: internal clock did not stabilize\n");
+			return -1;
+		}
+	}
+
+	clock = whyred_emmc_read16(base, SDHCI_CLOCK_CONTROL);
+	clock |= SDHCI_CLOCK_CARD_ENABLE;
+	whyred_emmc_write16(base, SDHCI_CLOCK_CONTROL, clock);
+	*divider_out = divider;
+	printf("WHYRED EMMC INIT: source upper=%lluHz caps base=%uMHz divider=%u target=%uHz output<=%lluHz\n",
+	    (unsigned long long)source_hz, base_mhz, divider,
+	    WHYRED_EMMC_INIT_CLOCK_HZ,
+	    (unsigned long long)(source_hz / (2 * divider)));
+	return 0;
+}
+
+static void
+whyred_emmc_select_legacy_mode(volatile uint8_t *base)
+{
+	uint8_t host = whyred_emmc_read8(base, SDHCI_HOST_CONTROL);
+	host &= (uint8_t)~SDHCI_HOST_WIDTH_AND_MODE_MASK;
+	whyred_emmc_write8(base, SDHCI_HOST_CONTROL, host);
+
+	uint16_t host2 = whyred_emmc_read16(base, SDHCI_HOST_CONTROL2);
+	host2 &= (uint16_t)~SDHCI_HOST2_UHS_MASK;
+	whyred_emmc_write16(base, SDHCI_HOST_CONTROL2, host2);
+
+	uint32_t vendor = whyred_emmc_read32(base, SDHCI_CORE_VENDOR_SPEC);
+	vendor &= ~(SDHCI_CORE_MCLK_SEL_MASK | SDHCI_CORE_HC_SELECT_IN_EN |
+	    SDHCI_CORE_HC_SELECT_IN_MASK);
+	vendor |= SDHCI_CORE_MCLK_SEL_DEFAULT;
+	whyred_emmc_write32(base, SDHCI_CORE_VENDOR_SPEC, vendor);
+	(void)whyred_emmc_read32(base, SDHCI_CORE_VENDOR_SPEC);
+	printf("WHYRED EMMC INIT: host set to 1-bit legacy; host2=0x%04x vendor=0x%08x\n",
+	    whyred_emmc_read16(base, SDHCI_HOST_CONTROL2),
+	    whyred_emmc_read32(base, SDHCI_CORE_VENDOR_SPEC));
 }
 

 void
+sweet_early_hex64(const char *label, uint64_t value)
+{
+#if defined(WHYRED_UARTDM)
+	static const char digits[] = "0123456789abcdef";
+	whyred_boot_uart_string("\r\nXNU_HEX ");
+	whyred_boot_uart_string(label);
+	whyred_boot_uart_string("=0x");
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		whyred_boot_uart_putc(digits[(value >> shift) & 0xf]);
+	}
+	whyred_boot_uart_string("\r\n");
+#else
+	(void)label;
+	(void)value;
+#endif
+}

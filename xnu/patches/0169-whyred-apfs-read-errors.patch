 #include <os/atomic_private.h>
 #include <pexpert/pexpert.h>
 
+/* No allocation, pathname lookup or VFS recursion on a failing paging path. */
+static int apfs_error_trace;
+static uint32_t apfs_error_sequence;
+extern unsigned int vm_page_free_count, vm_page_wire_count;
+
+void
+apfs_read_error(const char *stage, uint64_t ino, uint64_t offset,
+    uint64_t length, int error, int detail)
+{
+    if (!apfs_error_trace || !error ||
+        os_atomic_load(&apfs_error_sequence, relaxed) >= 32) return;
+    uint32_t sequence = os_atomic_inc_orig(&apfs_error_sequence, relaxed);
+    if (sequence >= 32) return;
+    printf("WHYRED APFS ERROR: seq=%u stage=%s ino=%llu off=%llu length=%llu "
+        "errno=%d detail=0x%x free=%u wired=%u\n", sequence + 1, stage,
+        (unsigned long long)ino, (unsigned long long)offset,
+        (unsigned long long)length, error, (unsigned int)detail,
+        os_atomic_load(&vm_page_free_count, relaxed),
+        os_atomic_load(&vm_page_wire_count, relaxed));
+}

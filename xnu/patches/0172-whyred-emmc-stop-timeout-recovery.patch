-/* CMD12 is a read-stop command, including when DATA_INHIBIT is still set. */
+/* A command timeout leaves CMD_INHIBIT latched on SDHCI. Clearing interrupt
+ * status alone does not release the command state machine for CMD13. */
+static int
+whyred_emmc_reset_read_host(volatile uint8_t *base)
+{
+	uint64_t timeout = whyred_emmc_timeout_ticks();
+	if (!timeout) return -1;
+	whyred_emmc_write8(base, SDHCI_SOFTWARE_RESET, 0x06); /* CMD and DATA only */
+	uint64_t start = whyred_emmc_counter();
+	while (whyred_emmc_read8(base, SDHCI_SOFTWARE_RESET) & 0x06) {
+		if (whyred_emmc_counter() - start >= timeout) return -1;
+	}
+	whyred_emmc_write32(base, SDHCI_INT_STATUS, whyred_emmc_read32(base, SDHCI_INT_STATUS));
+	return 0;
+}
+

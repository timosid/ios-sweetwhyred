+/* WHYRED_DRIVERKITD_POLICY_BEGIN */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Opt-in, finite per-daemon experiment; this value is not a measured budget. */
+#define WHYRED_DRIVERKITD_MEM_MB_MAX 512
+static int32_t whyred_driverkitd_mem_mb;
+
+static bool
+whyred_is_driverkitd(proc_t p)
+{
+	return p != PROC_NULL && strcmp(p->p_name, "driverkitd") == 0;
+}
+
+static void
+whyred_driverkitd_boot_config(void)
+{
+	if (!PE_parse_boot_argn("whyred_driverkitd_mem_mb", &whyred_driverkitd_mem_mb,
+	    sizeof(whyred_driverkitd_mem_mb))) {
+		return;
+	}
+	if (whyred_driverkitd_mem_mb < 0 ||
+	    whyred_driverkitd_mem_mb > WHYRED_DRIVERKITD_MEM_MB_MAX) {
+		printf("WHYRED driverkitd invalid floor_mb=%d (valid 0..%d); disabled\n",
+		    whyred_driverkitd_mem_mb, WHYRED_DRIVERKITD_MEM_MB_MAX);
+		whyred_driverkitd_mem_mb = 0;
+	} else if (whyred_driverkitd_mem_mb > 0) {
+		printf("WHYRED driverkitd footprint floor_mb=%d enabled\n",
+		    whyred_driverkitd_mem_mb);
+	}
+}
+
+static int32_t
+whyred_driverkitd_effective_mb(int32_t limit)
+{
+	/* <= 0 is written to the task ledger as -1: the system default.
+	 * A zero system default means unlimited and must never be lowered. */
+	return limit > 0 ? limit : max_task_footprint_mb;
+}
+
+static int32_t
+whyred_driverkitd_memlimit(proc_t p, int32_t limit)
+{
+	if (whyred_driverkitd_mem_mb == 0 || !whyred_is_driverkitd(p)) {
+		return limit;
+	}
+	int32_t effective_mb = whyred_driverkitd_effective_mb(limit);
+	if (effective_mb > 0 && effective_mb < whyred_driverkitd_mem_mb) {
+		return whyred_driverkitd_mem_mb;
+	}
+	return limit;
+}
+
+static void
+whyred_driverkitd_log_limits(proc_t p, int32_t old_active, int32_t old_inactive,
+    const char *source)
+{
+	if (whyred_driverkitd_mem_mb == 0 || !whyred_is_driverkitd(p)) {
+		return;
+	}
+	/* Called only when assigning budgets, never from state transitions.
+	 * old_* is the requested budget before the floor, not a prior sample.
+	 * effective_mb=0 denotes an unlimited system default. */
+	printf("WHYRED driverkitd limits source=%s pid=%d floor_mb=%d "
+	    "old_active_raw_mb=%d old_inactive_raw_mb=%d "
+	    "old_active_effective_mb=%d old_inactive_effective_mb=%d "
+	    "new_active_effective_mb=%d new_inactive_effective_mb=%d "
+	    "active_fatal=%d inactive_fatal=%d footprint_bytes=%llu\n",
+	    source, proc_getpid(p), whyred_driverkitd_mem_mb, old_active, old_inactive,
+	    whyred_driverkitd_effective_mb(old_active),
+	    whyred_driverkitd_effective_mb(old_inactive),
+	    whyred_driverkitd_effective_mb(p->p_memstat_memlimit_active),
+	    whyred_driverkitd_effective_mb(p->p_memstat_memlimit_inactive),
+	    !!(p->p_memstat_state & P_MEMSTAT_MEMLIMIT_ACTIVE_FATAL),
+	    !!(p->p_memstat_state & P_MEMSTAT_MEMLIMIT_INACTIVE_FATAL),
+	    get_task_phys_footprint(proc_task(p)));
+}
+
+static void
+whyred_driverkitd_log_footprint(proc_t p, boolean_t warning,
+    boolean_t active, boolean_t fatal)
+{
+	if (!whyred_is_driverkitd(p)) {
+		return;
+	}
+	int ledger_mb = -1;
+	kern_return_t kr = task_get_phys_footprint_limit(proc_task(p), &ledger_mb);
+	printf("WHYRED driverkitd footprint event=%s pid=%d ledger_mb=%d "
+	    "ledger_status=%d active=%d fatal=%d floor_mb=%d "
+	    "footprint_bytes=%llu active_raw_mb=%d inactive_raw_mb=%d\n",
+	    warning ? "warning" : "exceeded", proc_getpid(p), ledger_mb, kr,
+	    active, fatal, whyred_driverkitd_mem_mb,
+	    get_task_phys_footprint(proc_task(p)),
+	    p->p_memstat_memlimit_active, p->p_memstat_memlimit_inactive);
+}
+#else
+#define whyred_driverkitd_memlimit(p, limit) (limit)
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+/* WHYRED_DRIVERKITD_POLICY_END */

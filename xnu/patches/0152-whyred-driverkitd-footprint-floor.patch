+/* WHYRED_DRIVERKITD_EXEC_BEGIN */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+void
+memorystatus_whyred_driverkitd_exec(proc_t p)
+{
+	if (whyred_driverkitd_mem_mb == 0 || !whyred_is_driverkitd(p)) {
+		return;
+	}
+	/* launchd may spawn xpcproxy with the budget, then exec driverkitd
+	 * without POSIX_SPAWN_JETSAM_SET. Reapply only after the actual image
+	 * name and new proc/task association are installed, before user return. */
+	proc_list_lock();
+	int32_t old_active = p->p_memstat_memlimit_active;
+	int32_t old_inactive = p->p_memstat_memlimit_inactive;
+	boolean_t active_fatal = !!(p->p_memstat_state & P_MEMSTAT_MEMLIMIT_ACTIVE_FATAL);
+	boolean_t inactive_fatal = !!(p->p_memstat_state & P_MEMSTAT_MEMLIMIT_INACTIVE_FATAL);
+	SET_ACTIVE_LIMITS_LOCKED(p, old_active, active_fatal);
+	SET_INACTIVE_LIMITS_LOCKED(p, old_inactive, inactive_fatal);
+	boolean_t use_active = proc_jetsam_state_is_active_locked(p);
+	/* Do not disturb a direct ledger setting when this floor changed
+	 * neither the selected budget nor its fatal policy. The other slot
+	 * will be picked up by the normal active/inactive transition path. */
+	if ((use_active && p->p_memstat_memlimit_active != old_active) ||
+	    (!use_active && p->p_memstat_memlimit_inactive != old_inactive)) {
+		boolean_t is_fatal;
+		if (use_active) {
+			CACHE_ACTIVE_LIMITS_LOCKED(p, is_fatal);
+		} else {
+			CACHE_INACTIVE_LIMITS_LOCKED(p, is_fatal);
+		}
+		if (memorystatus_highwater_enabled) {
+			kern_return_t kr = task_set_phys_footprint_limit_internal(proc_task(p),
+			    p->p_memstat_memlimit > 0 ? p->p_memstat_memlimit : -1,
+			    NULL, use_active, is_fatal);
+			if (kr != KERN_SUCCESS) {
+				printf("WHYRED driverkitd exec ledger update failed pid=%d status=%d\n",
+				    proc_getpid(p), kr);
+			}
+		}
+	}
+	whyred_driverkitd_log_limits(p, old_active, old_inactive, "exec");
+	proc_list_unlock();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+/* WHYRED_DRIVERKITD_EXEC_END */

@@ -0,0 +1,99 @@
+/* CPU presentation for the boot framebuffer; no GPU or Apple display MMIO. */
+#ifndef SWEET_FRAMEBUFFER_BLIT_H
+#define SWEET_FRAMEBUFFER_BLIT_H
+#include <stdint.h>
+
+#define SWEET_FB_BGRA 0x42475241u
+#define SWEET_FB_RGBA 0x52474241u
+#define SWEET_FB_MAX_DIM 16384u
+
+struct sweet_fb_image {
+	uint8_t *pixels;
+	uint64_t length;
+	uint32_t width, height, row_bytes, offset, format;
+};
+
+struct sweet_fb_rect {
+	int32_t x, y, w, h;
+};
+
+static inline int
+sweet_fb_image_valid(const struct sweet_fb_image *image)
+{
+	if (!image->pixels || !image->width || !image->height ||
+	    image->width > SWEET_FB_MAX_DIM || image->height > SWEET_FB_MAX_DIM ||
+	    image->row_bytes < (uint64_t)image->width * 4 ||
+	    (image->format != SWEET_FB_BGRA && image->format != SWEET_FB_RGBA)) {
+		return 0;
+	}
+	uint64_t end = (uint64_t)image->offset +
+	    (uint64_t)(image->height - 1) * image->row_bytes + (uint64_t)image->width * 4;
+	return end <= image->length;
+}
+
+/*
+ * Destination coordinates use the logical iPhone canvas. Map pixel centers
+ * onto the real panel so all of a 1125x2436 frame fits whyred's 1080x2160
+ * panel. Signed 64-bit math covers every signed 32-bit destination rectangle;
+ * source spans are bounded before multiplication. Samples outside the source
+ * are skipped. Length checks precede every use of the mappings.
+ */
+static inline uint64_t
+sweet_fb_blit(const struct sweet_fb_image *source, struct sweet_fb_image *panel,
+    uint32_t logical_w, uint32_t logical_h,
+    struct sweet_fb_rect src, struct sweet_fb_rect dst)
+{
+	if (!sweet_fb_image_valid(source) || !sweet_fb_image_valid(panel) ||
+	    panel->format != SWEET_FB_BGRA || !logical_w || !logical_h ||
+	    logical_w > SWEET_FB_MAX_DIM || logical_h > SWEET_FB_MAX_DIM ||
+	    src.w <= 0 || src.h <= 0 || src.w > (int32_t)SWEET_FB_MAX_DIM ||
+	    src.h > (int32_t)SWEET_FB_MAX_DIM || dst.w <= 0 || dst.h <= 0) {
+		return 0;
+	}
+	int64_t right = (int64_t)dst.x + dst.w;
+	int64_t bottom = (int64_t)dst.y + dst.h;
+	if (right <= 0 || bottom <= 0 || dst.x >= (int64_t)logical_w ||
+	    dst.y >= (int64_t)logical_h) {
+		return 0;
+	}
+	uint32_t x0 = dst.x <= 0 ? 0 : (uint64_t)dst.x * panel->width / logical_w;
+	uint32_t y0 = dst.y <= 0 ? 0 : (uint64_t)dst.y * panel->height / logical_h;
+	uint32_t x1 = right >= logical_w ? panel->width :
+	    ((uint64_t)right * panel->width + logical_w - 1) / logical_w;
+	uint32_t y1 = bottom >= logical_h ? panel->height :
+	    ((uint64_t)bottom * panel->height + logical_h - 1) / logical_h;
+	uint64_t copied = 0;
+	for (uint32_t y = y0; y < y1; y++) {
+		int64_t yn = (int64_t)(2 * y + 1) * logical_h - (int64_t)dst.y * 2 * panel->height;
+		int64_t yd = (int64_t)dst.h * 2 * panel->height;
+		if (yn < 0 || yn >= yd) {
+			continue;
+		}
+		int64_t sy = (int64_t)src.y + yn * src.h / yd;
+		if (sy < 0 || sy >= source->height) {
+			continue;
+		}
+		const uint8_t *srow = source->pixels + source->offset + (uint64_t)sy * source->row_bytes;
+		uint8_t *drow = panel->pixels + panel->offset + (uint64_t)y * panel->row_bytes;
+		for (uint32_t x = x0; x < x1; x++) {
+			int64_t xn = (int64_t)(2 * x + 1) * logical_w - (int64_t)dst.x * 2 * panel->width;
+			int64_t xd = (int64_t)dst.w * 2 * panel->width;
+			if (xn < 0 || xn >= xd) {
+				continue;
+			}
+			int64_t sx = (int64_t)src.x + xn * src.w / xd;
+			if (sx < 0 || sx >= source->width) {
+				continue;
+			}
+			const uint8_t *s = srow + (uint64_t)sx * 4;
+			uint8_t *d = drow + (uint64_t)x * 4;
+			d[0] = s[source->format == SWEET_FB_RGBA ? 2 : 0];
+			d[1] = s[1];
+			d[2] = s[source->format == SWEET_FB_RGBA ? 0 : 2];
+			d[3] = s[3];
+			copied++;
+		}
+	}
+	return copied;
+}
+#endif

+/* MiCode's charger high-Z sequence overrides the controller's UTMI outputs
+ * with non-drive via TEST_MUX. V87 observes CTRL1=0x35 and CTRL2=0x40 after
+ * powered wake. Release only that mux, after the controller is halted and
+ * before installing DMA. Leave CTRL1, interface-select, tuning and PLL alone.
+ * Major-rev1 PHY registers have byte data (word reads can replicate the byte).
+ * Reject unfamiliar active overrides; never claim that readback proves a link.
+ */
+static bool
+whyred_usb_hw_release_test(const struct whyred_usb_io *io, struct whyred_usb_hw *hw)
+{
+    if (!hw->phy || !hw->dwc) return false;
+    if ((io->read(io->context, hw->dwc, 0xc704) & (1u << 31)) ||
+        !(io->read(io->context, hw->dwc, 0xc70c) & (1u << 22))) return false;
+    hw->utmi1_before = io->read(io->context, hw->phy, WHYRED_USB_PHY_UTMI_CTRL1);
+    hw->utmi2_before = io->read(io->context, hw->phy, WHYRED_USB_PHY_UTMI_CTRL2);
+    hw->utmi2_after = hw->utmi2_before;
+    uint32_t before = hw->utmi2_before & 0xffu;
+    if (!(before & WHYRED_USB_UTMI_TEST_MUX)) return true;
+    if ((hw->utmi1_before & WHYRED_USB_UTMI_OVERRIDE_MASK) !=
+        WHYRED_USB_UTMI_NONDRIVE_FS) return false;
+    hw->utmi_release_attempted = 1;
+    uint32_t target = before & ~WHYRED_USB_UTMI_TEST_MUX;
+    io->write(io->context, hw->phy, WHYRED_USB_PHY_UTMI_CTRL2, target);
+    hw->utmi2_after = io->read(io->context, hw->phy, WHYRED_USB_PHY_UTMI_CTRL2);
+    if ((hw->utmi2_after & 0xffu) == target) {
+        hw->utmi_release_changed = 1;
+        return true;
+    }
+    /* On failure restore only our mux bit, retaining other sampled bits. */
+    io->write(io->context, hw->phy, WHYRED_USB_PHY_UTMI_CTRL2,
+        (hw->utmi2_after & 0xffu) | WHYRED_USB_UTMI_TEST_MUX);
+    hw->utmi2_restore = io->read(io->context, hw->phy, WHYRED_USB_PHY_UTMI_CTRL2);
+    hw->utmi_release_restored = (hw->utmi2_restore & 0xffu) == before;
+    return false;
+}

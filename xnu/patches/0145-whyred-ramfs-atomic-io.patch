+/* Volatile fsync orders mapped writes into the backing pages; it promises no media durability. */
+static int
+ramfs_sync_file(vnode_t vp)
+{
+	struct ramfs_node *node = RAMFS_NODE(vp);
+	if (node->rn_type != VREG || !node->rn_mapped_write) return 0;
+	off_t size = ubc_getsize(vp);
+	if (size <= 0) return 0;
+	/* Never hold rm_lock: pageout takes it. Propagate paging errors to callers. */
+	return ubc_msync(vp, 0, size, NULL, UBC_PUSHDIRTY | UBC_SYNC);
+}
+
+static int
+ramfs_fsync(struct vnop_fsync_args *ap)
+{
+	return ramfs_sync_file(ap->a_vp);
+}
+
+static int
+ramfs_ioctl(struct vnop_ioctl_args *ap)
+{
+	switch (ap->a_command) {
+	case F_FULLFSYNC:
+	case F_BARRIERFSYNC:
+		return ramfs_sync_file(ap->a_vp);
+	default:
+		return ENOTTY;
+	}
 }
 

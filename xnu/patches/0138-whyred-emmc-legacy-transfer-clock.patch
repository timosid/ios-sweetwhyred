 			    ocr, (unsigned int)ext_csd[61], (unsigned int)ext_csd[179]);
 		} else {
+			if (whyred_emmc_set_legacy_transfer_clock(base, caps) != 0) {
+				printf("WHYRED EMMC: retaining 200kHz identification clock for GPT reads\n");
+			}
 			struct whyred_gpt_io io = { .base = base, .sectors = sectors };
 			whyred_emmc_live_io = io;

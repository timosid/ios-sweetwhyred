+/* Cache materialization runs as root before logd takes ownership. Recognize
+ * /db/uuidtext/dsc inside this /var mount at the common namespace insertion.
+ * Classification follows inode aliases and directory moves for its lifetime;
+ * an owner change cannot remove it. A prepopulated directory moved into the
+ * cache is classified too. Recursion follows only db -> uuidtext -> dsc (three
+ * frames), followed by one scan of direct DSC entries; no arbitrary tree walk.
+ * The mount lock is held. No data is allocated, removed or truncated here.
+ */
+static void
+ramfs_logd_classify_locked(struct ramfs_node *dir, struct ramfs_dirent *de, struct ramfs_node *node)
+{
+	if (!dir->rn_mount->rm_logd_file_limit) return;
+	if (node->rn_type == VREG) {
+		if (dir->rn_logd_role & RAMFS_LOGD_DSC) node->rn_logd_dsc = true;
+		return;
+	}
+	if (node->rn_type != VDIR) return;
+	uint8_t role = 0;
+	if (dir == dir->rn_mount->rm_root && de->rd_namelen == 2 &&
+	    memcmp(de->rd_name, "db", 2) == 0) role = RAMFS_LOGD_DB;
+	else if ((dir->rn_logd_role & RAMFS_LOGD_DB) && de->rd_namelen == 8 &&
+	    memcmp(de->rd_name, "uuidtext", 8) == 0) role = RAMFS_LOGD_UUIDTEXT;
+	else if ((dir->rn_logd_role & RAMFS_LOGD_UUIDTEXT) && de->rd_namelen == 3 &&
+	    memcmp(de->rd_name, "dsc", 3) == 0) role = RAMFS_LOGD_DSC;
+	if (!role || (node->rn_logd_role & role)) return;
+	node->rn_logd_role |= role;
+	if (role == RAMFS_LOGD_DSC) {
+		struct ramfs_dirent *child;
+		TAILQ_FOREACH(child, &node->rn_entries, rd_link) {
+			if (child->rd_node->rn_type == VREG) child->rd_node->rn_logd_dsc = true;
+		}
+	} else {
+		const char *name = role == RAMFS_LOGD_DB ? "uuidtext" : "dsc";
+		size_t length = role == RAMFS_LOGD_DB ? 8 : 3;
+		struct ramfs_dirent *child = ramfs_dir_find(node, name, length);
+		if (child) ramfs_logd_classify_locked(node, child, child->rd_node);
+	}
+}

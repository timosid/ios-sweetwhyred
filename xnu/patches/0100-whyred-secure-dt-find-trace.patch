 }
 
 int
@@ -293,16 +301,24 @@
 {
 	DeviceTreeNode const *nodeP = (DeviceTreeNode const *) (void const *) startingP;
 	unsigned int k;
-
+	unsigned int trace_depth = whyred_find_entry_depth++;
+
+	if (trace_depth < 16) {
+		sweet_early_mark(40 + trace_depth, "SecureDTFindEntry recursion depth");
+	}
 	ASSERT_HEADER_IN_DT(nodeP, sizeof(DeviceTreeNode));
 
 	if (nodeP->nProperties == 0) {
+		whyred_find_entry_depth--;
 		return kError;                        // End of the list of nodes
 	}
 	startingP = (char const *) (nodeP + 1);
 
 	// Search current entry
 	for (k = 0; k < nodeP->nProperties; ++k) {
+		if (trace_depth == 0 && k < 16) {
+			sweet_early_mark(60 + k, "SecureDTFindEntry root property");

diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 19f27cd..14ea4b2 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -698,6 +698,115 @@ register_serial_functions(struct pe_serial_functions *fns)
 	gPESF = fns;
 }
 
+#ifdef WHYRED_UARTDM
+/*
+ * whyred debug UART: ABL and the shim use UARTDM at physical 0x0c170000.
+ * Preserve the firmware's 115200 8-N-1 clock/pin configuration; only push
+ * single-byte PIO words through the TX FIFO. All waits are bounded so a
+ * missing/unclocked peripheral cannot hang kernel startup.
+ */
+#define WHYRED_UARTDM_PA       0x0c170000ULL
+#define WHYRED_UARTDM_SIZE     0x1000
+#define WHYRED_UARTDM_CR       0x10
+#define WHYRED_UARTDM_ISR      0x14
+#define WHYRED_UARTDM_SR       0x08
+#define WHYRED_UARTDM_NCF_TX   0x40
+#define WHYRED_UARTDM_TX       0x70
+#define WHYRED_UARTDM_CR_RESET_TX_READY 0x300
+#define WHYRED_UARTDM_SR_TX_READY       (1u << 2)
+
+static volatile uint32_t *whyred_uartdm_registers;
+
+static uint32_t
+whyred_uartdm_read(unsigned int offset)
+{
+	return whyred_uartdm_registers[offset / sizeof(uint32_t)];
+}
+
+static void
+whyred_uartdm_write(unsigned int offset, uint32_t value)
+{
+	whyred_uartdm_registers[offset / sizeof(uint32_t)] = value;
+}
+
+static unsigned int
+whyred_uartdm_transmit_ready(void)
+{
+	/* transmit_data() performs a bounded hardware-ready poll itself. */
+	return whyred_uartdm_registers != NULL;
+}
+
+static void
+whyred_uartdm_transmit_data(uint8_t c)
+{
+	if (whyred_uartdm_registers == NULL) {
+		return;
+	}
+	/* Match the working shim protocol: drain TX before changing NCF_TX. */
+	uint32_t idle;
+	for (idle = 0; idle < 0x10000; idle++) {
+		if ((whyred_uartdm_read(WHYRED_UARTDM_SR) & (1u << 3)) ||
+		    (whyred_uartdm_read(WHYRED_UARTDM_ISR) & (1u << 7))) {
+			break;
+		}
+	}
+	if (idle == 0x10000) {
+		return;
+	}
+	whyred_uartdm_write(WHYRED_UARTDM_CR, WHYRED_UARTDM_CR_RESET_TX_READY);
+	whyred_uartdm_write(WHYRED_UARTDM_NCF_TX, 1);
+	(void)whyred_uartdm_read(WHYRED_UARTDM_NCF_TX);
+	for (uint32_t i = 0; i < 0x10000; i++) {
+		if (whyred_uartdm_read(WHYRED_UARTDM_SR) & WHYRED_UARTDM_SR_TX_READY) {
+			whyred_uartdm_write(WHYRED_UARTDM_TX, c);
+			return;
+		}
+	}
+}
+
+static unsigned int
+whyred_uartdm_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+whyred_uartdm_receive_data(void)
+{
+	return 0;
+}
+
+static void
+whyred_uartdm_init(void)
+{
+	static const char banner[] = "\r\n[whyred-XNU] UARTDM console ready\r\n";
+	for (const char *p = banner; *p; p++) {
+		whyred_uartdm_transmit_data((uint8_t)*p);
+	}
+}
+
+static SECURITY_READ_ONLY_LATE(struct pe_serial_functions) whyred_uartdm_serial_functions = {
+	.init = whyred_uartdm_init,
+	.transmit_ready = whyred_uartdm_transmit_ready,
+	.transmit_data = whyred_uartdm_transmit_data,
+	.receive_ready = whyred_uartdm_receive_ready,
+	.receive_data = whyred_uartdm_receive_data,
+	.device = SERIAL_WHYRED_UARTDM
+};
+
+static void
+whyred_uartdm_probe(void)
+{
+	if (whyred_uartdm_registers != NULL) {
+		return;
+	}
+	whyred_uartdm_registers = (volatile uint32_t *)ml_io_map(WHYRED_UARTDM_PA, WHYRED_UARTDM_SIZE);
+	if (whyred_uartdm_registers != NULL) {
+		register_serial_functions(&whyred_uartdm_serial_functions);
+	}
+}
+#endif /* WHYRED_UARTDM */
+
 /*****************************************************************************/
 
 /*
@@ -1044,6 +1153,10 @@ serial_init(void)
 	}
 #endif /* APPLE_UART */
 
+	#ifdef WHYRED_UARTDM
+	whyred_uartdm_probe();
+	#endif /* WHYRED_UARTDM */
+
 	if (gPESF == NULL) {
 		return 0;
 	}

diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index fce00c8..3cd41e7 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,6 +11,48 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+
+#if defined(WHYRED_UARTDM)
+/* Only valid while the bootstrap identity UART mapping is installed. */
+static unsigned int whyred_boot_uart_disabled;
+static volatile uint32_t * const whyred_boot_uart = (volatile uint32_t *)(uintptr_t)0x0c170000;
+
+static void
+whyred_boot_uart_putc(char c)
+{
+ if (whyred_boot_uart_disabled) {
+  return;
+ }
+ uint32_t i;
+ for (i = 0; i < 0x10000; i++) {
+  if ((whyred_boot_uart[0x08 / 4] & (1u << 3)) ||
+      (whyred_boot_uart[0x14 / 4] & (1u << 7))) {
+   break;
+  }
+ }
+ if (i == 0x10000) {
+  return;
+ }
+ whyred_boot_uart[0x10 / 4] = 0x300;
+ whyred_boot_uart[0x40 / 4] = 1;
+ (void)whyred_boot_uart[0x40 / 4];
+ for (i = 0; i < 0x10000; i++) {
+  if (whyred_boot_uart[0x08 / 4] & (1u << 2)) {
+   whyred_boot_uart[0x70 / 4] = (unsigned char)c;
+   return;
+  }
+ }
+}
+
+static void
+whyred_boot_uart_string(const char *s)
+{
+ while (*s) {
+  whyred_boot_uart_putc(*s++);
+ }
+}
+#endif
+
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9d400000;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
@@ -89,6 +131,17 @@ sweet_early_string(const char *s)
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
+#if defined(WHYRED_UARTDM)
+ whyred_boot_uart_string("\r\nXNU_C");
+ if (stage >= 10) {
+  whyred_boot_uart_putc((char)('0' + stage / 10));
+ }
+ whyred_boot_uart_putc((char)('0' + stage % 10));
+ whyred_boot_uart_string(": ");
+ whyred_boot_uart_string(label);
+ whyred_boot_uart_string("\r\n");
+#endif
+
 	if (early_disabled || stage > 20) {
 		return;
 	}
@@ -116,6 +169,14 @@ sweet_early_panic(const char *fmt, va_list *args)
 		return;
 	}
 	early_panicking = 1;
+#if defined(WHYRED_UARTDM)
+ whyred_boot_uart_string("\r\nXNU_EARLY_PANIC: ");
+ va_list uart_copy;
+ va_copy(uart_copy, *args);
+ _doprnt(fmt, &uart_copy, whyred_boot_uart_putc, 16);
+ va_end(uart_copy);
+ whyred_boot_uart_string("\r\n");
+#endif
 	sweet_early_string("\nSWEET EARLY PANIC: ");
 	va_list copy;
 	va_copy(copy, *args);
@@ -132,11 +193,18 @@ sweet_early_relocate(uint64_t base)
 	early_fb = (volatile uint32_t *)(uintptr_t)base;
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
+#if defined(WHYRED_UARTDM)
+ /* TTBR0 is about to be removed; the regular UART uses its own ml_io_map. */
+ whyred_boot_uart_disabled = 1;
+#endif
 }
 
 void
 sweet_early_disable(void)
 {
+#if defined(WHYRED_UARTDM)
+ whyred_boot_uart_disabled = 1;
+#endif
 	early_disabled = 1;
 	__asm__ volatile("dsb sy" ::: "memory");
 }

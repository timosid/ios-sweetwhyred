diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 2a21aa1..9d76c04 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -506,6 +506,68 @@ start_cpu:
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+#if defined(WHYRED_UARTDM)
+	/* XNU0: prove entry into start_first_cpu over the shim's UARTDM. */
+	MOV64	x9, 0x0c170000
+	// Wait for the shim text to leave the FIFO before changing NCF_TX.
+	mov		x12, #0x10000
+Lwhyred_uart_entry_idle:
+	ldr		w11, [x9, #0x08]
+	tbnz	w11, #3, Lwhyred_uart_entry_idle_ready
+	ldr		w11, [x9, #0x14]
+	tbnz	w11, #7, Lwhyred_uart_entry_idle_ready
+	subs	x12, x12, #1
+	b.ne	Lwhyred_uart_entry_idle
+	b		Lsweet_uart_xnu0_done
+Lwhyred_uart_entry_idle_ready:
+	// UARTDM PIO word "XNU0" (firmware leaves 115200 8-N-1 configured).
+	mov		w10, #0x300
+	str		w10, [x9, #0x10]
+	mov		w10, #4
+	str		w10, [x9, #0x40]
+	ldr		w11, [x9, #0x40]
+	mov		x12, #0x10000
+Lsweet_uart_xnu0_wait:
+	ldr		w11, [x9, #0x08]
+	tbnz	w11, #2, Lsweet_uart_xnu0_ready
+	subs		x12, x12, #1
+	b.ne	Lsweet_uart_xnu0_wait
+	b		Lsweet_uart_xnu0_done
+Lsweet_uart_xnu0_ready:
+	mov		w10, #0x5558
+	movk	w10, #0x304e, lsl #16
+	str		w10, [x9, #0x70]
+
+	// Drain the marker before starting the separate CRLF transfer.
+	mov		x12, #0x10000
+Lwhyred_uart_crlf_idle:
+	ldr		w11, [x9, #0x08]
+	tbnz	w11, #3, Lwhyred_uart_crlf_idle_ready
+	ldr		w11, [x9, #0x14]
+	tbnz	w11, #7, Lwhyred_uart_crlf_idle_ready
+	subs	x12, x12, #1
+	b.ne	Lwhyred_uart_crlf_idle
+	b		Lsweet_uart_xnu0_done
+Lwhyred_uart_crlf_idle_ready:
+	mov		w10, #0x300
+	str		w10, [x9, #0x10]
+	mov		w10, #2
+	str		w10, [x9, #0x40]
+	ldr		w11, [x9, #0x40]
+	mov		x12, #0x10000
+Lsweet_uart_crlf_wait:
+	ldr		w11, [x9, #0x08]
+	tbnz	w11, #2, Lsweet_uart_crlf_ready
+	subs		x12, x12, #1
+	b.ne	Lsweet_uart_crlf_wait
+	b		Lsweet_uart_xnu0_done
+Lsweet_uart_crlf_ready:
+	mov		w10, #0x0a0d
+	str		w10, [x9, #0x70]
+Lsweet_uart_xnu0_done:
+	dsb		sy
+#endif
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -530,6 +592,8 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+
+
 #endif
 
 	// Set low reset vector before attempting any loads
diff --git a/pexpert/arm/pe_identify_machine.c b/pexpert/arm/pe_identify_machine.c
index aa75c0a..749a450 100644
--- a/pexpert/arm/pe_identify_machine.c
+++ b/pexpert/arm/pe_identify_machine.c
@@ -188,8 +188,18 @@ pe_arm_get_soc_base_phys(void)
 			strlcpy(gPESoCDeviceTypeBuffer, tmpStr, SOC_DEVICE_TYPE_BUFFER_SIZE);
 			gPESoCDeviceType = gPESoCDeviceTypeBuffer;
 
-			SecureDTGetProperty(entryP, "ranges", (void const **)&ranges_prop, &prop_size);
-			gPESoCBasePhys = *(ranges_prop + 1);
+			if (SecureDTGetProperty(entryP, "ranges", (void const **)&ranges_prop, &prop_size) == kSuccess &&
+			    prop_size >= 2 * sizeof(*ranges_prop)) {
+				gPESoCBasePhys = *(ranges_prop + 1);
+			} else {
+				/* whyred synthetic ADT provides arm-io reg, not ranges. */
+				uintptr_t const *reg_prop = NULL;
+				if (SecureDTGetProperty(entryP, "reg", (void const **)&reg_prop, &prop_size) != kSuccess ||
+				    prop_size < sizeof(*reg_prop)) {
+					return 0;
+				}
+				gPESoCBasePhys = *reg_prop;
+			}
 		}
 		return gPESoCBasePhys;
 	}
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 19f27cd..14ea4b2 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -698,6 +698,115 @@ register_serial_functions(struct pe_serial_functions *fns)
 	gPESF = fns;
 }
 
+#ifdef WHYRED_UARTDM
+/*
+ * whyred debug UART: ABL and the shim use UARTDM at physical 0x0c170000.
+ * Preserve the firmware's 115200 8-N-1 clock/pin configuration; only push
+ * single-byte PIO words through the TX FIFO. All waits are bounded so a
+ * missing/unclocked peripheral cannot hang kernel startup.
+ */
+#define WHYRED_UARTDM_PA       0x0c170000ULL
+#define WHYRED_UARTDM_SIZE     0x1000
+#define WHYRED_UARTDM_CR       0x10
+#define WHYRED_UARTDM_ISR      0x14
+#define WHYRED_UARTDM_SR       0x08
+#define WHYRED_UARTDM_NCF_TX   0x40
+#define WHYRED_UARTDM_TX       0x70
+#define WHYRED_UARTDM_CR_RESET_TX_READY 0x300
+#define WHYRED_UARTDM_SR_TX_READY       (1u << 2)
+
+static volatile uint32_t *whyred_uartdm_registers;
+
+static uint32_t
+whyred_uartdm_read(unsigned int offset)
+{
+	return whyred_uartdm_registers[offset / sizeof(uint32_t)];
+}
+
+static void
+whyred_uartdm_write(unsigned int offset, uint32_t value)
+{
+	whyred_uartdm_registers[offset / sizeof(uint32_t)] = value;
+}
+
+static unsigned int
+whyred_uartdm_transmit_ready(void)
+{
+	/* transmit_data() performs a bounded hardware-ready poll itself. */
+	return whyred_uartdm_registers != NULL;
+}
+
+static void
+whyred_uartdm_transmit_data(uint8_t c)
+{
+	if (whyred_uartdm_registers == NULL) {
+		return;
+	}
+	/* Match the working shim protocol: drain TX before changing NCF_TX. */
+	uint32_t idle;
+	for (idle = 0; idle < 0x10000; idle++) {
+		if ((whyred_uartdm_read(WHYRED_UARTDM_SR) & (1u << 3)) ||
+		    (whyred_uartdm_read(WHYRED_UARTDM_ISR) & (1u << 7))) {
+			break;
+		}
+	}
+	if (idle == 0x10000) {
+		return;
+	}
+	whyred_uartdm_write(WHYRED_UARTDM_CR, WHYRED_UARTDM_CR_RESET_TX_READY);
+	whyred_uartdm_write(WHYRED_UARTDM_NCF_TX, 1);
+	(void)whyred_uartdm_read(WHYRED_UARTDM_NCF_TX);
+	for (uint32_t i = 0; i < 0x10000; i++) {
+		if (whyred_uartdm_read(WHYRED_UARTDM_SR) & WHYRED_UARTDM_SR_TX_READY) {
+			whyred_uartdm_write(WHYRED_UARTDM_TX, c);
+			return;
+		}
+	}
+}
+
+static unsigned int
+whyred_uartdm_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+whyred_uartdm_receive_data(void)
+{
+	return 0;
+}
+
+static void
+whyred_uartdm_init(void)
+{
+	static const char banner[] = "\r\n[whyred-XNU] UARTDM console ready\r\n";
+	for (const char *p = banner; *p; p++) {
+		whyred_uartdm_transmit_data((uint8_t)*p);
+	}
+}
+
+static SECURITY_READ_ONLY_LATE(struct pe_serial_functions) whyred_uartdm_serial_functions = {
+	.init = whyred_uartdm_init,
+	.transmit_ready = whyred_uartdm_transmit_ready,
+	.transmit_data = whyred_uartdm_transmit_data,
+	.receive_ready = whyred_uartdm_receive_ready,
+	.receive_data = whyred_uartdm_receive_data,
+	.device = SERIAL_WHYRED_UARTDM
+};
+
+static void
+whyred_uartdm_probe(void)
+{
+	if (whyred_uartdm_registers != NULL) {
+		return;
+	}
+	whyred_uartdm_registers = (volatile uint32_t *)ml_io_map(WHYRED_UARTDM_PA, WHYRED_UARTDM_SIZE);
+	if (whyred_uartdm_registers != NULL) {
+		register_serial_functions(&whyred_uartdm_serial_functions);
+	}
+}
+#endif /* WHYRED_UARTDM */
+
 /*****************************************************************************/
 
 /*
@@ -1044,6 +1153,10 @@ serial_init(void)
 	}
 #endif /* APPLE_UART */
 
+	#ifdef WHYRED_UARTDM
+	whyred_uartdm_probe();
+	#endif /* WHYRED_UARTDM */
+
 	if (gPESF == NULL) {
 		return 0;
 	}

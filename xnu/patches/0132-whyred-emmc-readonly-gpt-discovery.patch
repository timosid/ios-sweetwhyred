--- a/bsd/dev/whyred_emmc_pio_probe.c
+++ b/bsd/dev/whyred_emmc_pio_probe.c
@@ -3,12 +3,14 @@
  *
  * This opt-in diagnostic preserves the existing SDCC1 power rails, returns
  * the card and host to the eMMC legacy 1-bit initialization mode, then reads
- * only EXT_CSD. It never reads user sectors or issues a media-write command.
+ * EXT_CSD and opt-in primary GPT metadata. It issues no media-write command
+ * and does not read partition contents.
  */
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <machine/machine_routines.h>
 #include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
 

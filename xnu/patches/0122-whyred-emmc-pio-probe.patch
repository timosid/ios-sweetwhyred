--- /dev/null
+++ b/bsd/dev/whyred_emmc_pio_probe.c
@@ -0,0 +1,337 @@
+/*
+ * Whyred read-only eMMC command probe.
+ *
+ * This opt-in diagnostic uses the bootloader's existing SDCC1 power/clock
+ * state. It sends CMD13 (SEND_STATUS) and, only when the card reports the
+ * Transfer state, CMD8 (SEND_EXT_CSD) using bounded polling PIO. It never
+ * issues a user-area read or any media-write command.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <vm/vm_kern.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#define WHYRED_SDCC1_HC_PHYS             0x0c0c4000ULL
+#define WHYRED_SDCC1_HC_SIZE             0x1000
+#define SDHCI_PRESENT_STATE              0x24
+#define SDHCI_HOST_CONTROL               0x28
+#define SDHCI_POWER_CONTROL              0x29
+#define SDHCI_CLOCK_CONTROL              0x2c
+#define SDHCI_INT_STATUS                 0x30
+#define SDHCI_SIGNAL_ENABLE              0x38
+#define SDHCI_ARGUMENT                   0x08
+#define SDHCI_BLOCK_SIZE                 0x04
+#define SDHCI_BLOCK_COUNT                0x06
+#define SDHCI_TRANSFER_MODE              0x0c
+#define SDHCI_COMMAND                    0x0e
+#define SDHCI_RESPONSE                   0x10
+#define SDHCI_BUFFER                     0x20
+#define SDHCI_PSTATE_CMD_INHIBIT         0x00000001
+#define SDHCI_PSTATE_DATA_INHIBIT        0x00000002
+#define SDHCI_PSTATE_DATA_AVAILABLE      0x00000800
+#define SDHCI_PSTATE_DAT4_TO_DAT7        0x000000f0
+#define SDHCI_PSTATE_DAT0_TO_DAT3        0x00f00000
+#define SDHCI_PSTATE_CMD_LEVEL            0x01000000
+#define SDHCI_CLOCK_CARD_ENABLE          0x0004
+#define SDHCI_CLOCK_INT_STABLE           0x0002
+#define SDHCI_CLOCK_INT_ENABLE           0x0001
+#define SDHCI_POWER_ENABLE               0x01
+#define SDHCI_INT_RESPONSE               0x00000001
+#define SDHCI_INT_DATA_END               0x00000002
+#define SDHCI_INT_DATA_AVAILABLE         0x00000020
+#define SDHCI_INT_ERROR                  0x00008000
+#define SDHCI_INT_ERROR_MASK             0xffff8000
+#define SDHCI_XFER_BLOCK_COUNT_ENABLE    0x0002
+#define SDHCI_XFER_READ                  0x0010
+#define SDHCI_CMD_RESP_SHORT_CRC_INDEX   0x001a
+#define SDHCI_CMD_DATA_PRESENT           0x0020
+#define SDHCI_CMD_SEND_STATUS            13
+#define SDHCI_CMD_SEND_EXT_CSD           8
+#define WHYRED_EMMC_RCA                  1
+#define WHYRED_EXT_CSD_BYTES             512
+#define WHYRED_EMMC_TIMEOUT_MS           1000
+#define WHYRED_EMMC_STATUS_TRANSFER      4
+#define WHYRED_EMMC_STATUS_READY         0x00000100
+
+/* Not exported to the BSD layer by machine/machine_routines.h. */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+static uint16_t
+whyred_emmc_read16(volatile uint8_t *base, unsigned int offset)
+{
+	return *(volatile uint16_t *)(base + offset);
+}
+
+static uint32_t
+whyred_emmc_read32(volatile uint8_t *base, unsigned int offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static void
+whyred_emmc_write16(volatile uint8_t *base, unsigned int offset, uint16_t value)
+{
+	*(volatile uint16_t *)(base + offset) = value;
+}
+
+static void
+whyred_emmc_write32(volatile uint8_t *base, unsigned int offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+}
+
+static uint64_t
+whyred_emmc_counter(void)
+{
+	return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+static uint64_t
+whyred_emmc_timeout_ticks(void)
+{
+	uint64_t frequency = __builtin_arm_rsr64("CNTFRQ_EL0");
+	if (frequency == 0) {
+		return 0;
+	}
+	uint64_t ticks = (frequency * WHYRED_EMMC_TIMEOUT_MS) / 1000;
+	return ticks ? ticks : 1;
+}
+
+static int
+whyred_emmc_wait_status(volatile uint8_t *base, uint32_t wanted,
+    uint64_t start, uint64_t timeout, uint32_t *status_out)
+{
+	for (;;) {
+		uint32_t status = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+		if (status_out != NULL) {
+			*status_out = status;
+		}
+		if ((status & (wanted | SDHCI_INT_ERROR_MASK)) != 0) {
+			return 0;
+		}
+		if ((whyred_emmc_counter() - start) >= timeout) {
+			return -1;
+		}
+	}
+}
+
+static int
+whyred_emmc_command(volatile uint8_t *base, uint32_t argument,
+    uint16_t command, uint32_t *response)
+{
+	uint32_t stale = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+	if (stale != 0) {
+		printf("WHYRED EMMC: refusing command, stale int=0x%08x\n", stale);
+		return -1;
+	}
+
+	uint64_t timeout = whyred_emmc_timeout_ticks();
+	if (timeout == 0) {
+		printf("WHYRED EMMC: CNTFRQ is zero; command probe skipped\n");
+		return -1;
+	}
+
+	whyred_emmc_write32(base, SDHCI_ARGUMENT, argument);
+	whyred_emmc_write16(base, SDHCI_COMMAND, command);
+	uint64_t start = whyred_emmc_counter();
+	uint32_t status = 0;
+	if (whyred_emmc_wait_status(base, SDHCI_INT_RESPONSE, start,
+	    timeout, &status) != 0) {
+		printf("WHYRED EMMC: cmd%u timeout int=0x%08x\n",
+		    (unsigned int)((command >> 8) & 0x3f), status);
+		return -1;
+	}
+	if ((status & SDHCI_INT_ERROR_MASK) != 0 ||
+	    (status & SDHCI_INT_RESPONSE) == 0) {
+		printf("WHYRED EMMC: cmd%u error int=0x%08x\n",
+		    (unsigned int)((command >> 8) & 0x3f), status);
+		whyred_emmc_write32(base, SDHCI_INT_STATUS,
+		    status & (SDHCI_INT_RESPONSE | SDHCI_INT_ERROR_MASK));
+		return -1;
+	}
+
+	*response = whyred_emmc_read32(base, SDHCI_RESPONSE);
+	whyred_emmc_write32(base, SDHCI_INT_STATUS, SDHCI_INT_RESPONSE);
+	return 0;
+}
+
+static int
+whyred_emmc_read_ext_csd(volatile uint8_t *base, uint8_t *ext_csd)
+{
+	uint16_t old_block_size = whyred_emmc_read16(base, SDHCI_BLOCK_SIZE);
+	uint16_t old_block_count = whyred_emmc_read16(base, SDHCI_BLOCK_COUNT);
+	uint16_t old_transfer_mode = whyred_emmc_read16(base, SDHCI_TRANSFER_MODE);
+	uint32_t response = 0;
+
+	whyred_emmc_write16(base, SDHCI_BLOCK_SIZE, WHYRED_EXT_CSD_BYTES);
+	whyred_emmc_write16(base, SDHCI_BLOCK_COUNT, 1);
+	/* DMA remains disabled: the single 512-byte block is transferred by PIO. */
+	whyred_emmc_write16(base, SDHCI_TRANSFER_MODE,
+	    SDHCI_XFER_BLOCK_COUNT_ENABLE | SDHCI_XFER_READ);
+
+	uint16_t command = (SDHCI_CMD_SEND_EXT_CSD << 8) |
+	    SDHCI_CMD_RESP_SHORT_CRC_INDEX | SDHCI_CMD_DATA_PRESENT;
+	if (whyred_emmc_command(base, 0, command, &response) != 0) {
+		return -1;
+	}
+
+	uint64_t timeout = whyred_emmc_timeout_ticks();
+	if (timeout == 0) {
+		return -1;
+	}
+	uint64_t start = whyred_emmc_counter();
+	uint32_t status = 0;
+	while ((whyred_emmc_read32(base, SDHCI_PRESENT_STATE) &
+	    SDHCI_PSTATE_DATA_AVAILABLE) == 0) {
+		status = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+		if ((status & SDHCI_INT_ERROR_MASK) != 0) {
+			printf("WHYRED EMMC: EXT_CSD data error int=0x%08x\n", status);
+			whyred_emmc_write32(base, SDHCI_INT_STATUS,
+			    status & SDHCI_INT_ERROR_MASK);
+			return -1;
+		}
+		if ((status & SDHCI_INT_DATA_END) != 0) {
+			printf("WHYRED EMMC: EXT_CSD ended before PIO data\n");
+			whyred_emmc_write32(base, SDHCI_INT_STATUS, SDHCI_INT_DATA_END);
+			return -1;
+		}
+		if ((whyred_emmc_counter() - start) >= timeout) {
+			printf("WHYRED EMMC: EXT_CSD PIO data-ready timeout int=0x%08x\n",
+			    status);
+			return -1;
+		}
+	}
+
+	/* SDHCI PIO exposes a complete block when DATA_AVAILABLE is asserted. */
+	for (unsigned int words = 0; words < (WHYRED_EXT_CSD_BYTES / 4); words++) {
+		uint32_t value = whyred_emmc_read32(base, SDHCI_BUFFER);
+		ext_csd[words * 4 + 0] = (uint8_t)value;
+		ext_csd[words * 4 + 1] = (uint8_t)(value >> 8);
+		ext_csd[words * 4 + 2] = (uint8_t)(value >> 16);
+		ext_csd[words * 4 + 3] = (uint8_t)(value >> 24);
+	}
+	status = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+	if ((status & SDHCI_INT_DATA_AVAILABLE) != 0) {
+		whyred_emmc_write32(base, SDHCI_INT_STATUS, SDHCI_INT_DATA_AVAILABLE);
+	}
+
+	status = 0;
+	if (whyred_emmc_wait_status(base, SDHCI_INT_DATA_END, start,
+	    timeout, &status) != 0 || (status & SDHCI_INT_DATA_END) == 0 ||
+	    (status & SDHCI_INT_ERROR_MASK) != 0) {
+		printf("WHYRED EMMC: EXT_CSD completion error int=0x%08x\n", status);
+		if (status != 0) {
+			whyred_emmc_write32(base, SDHCI_INT_STATUS,
+			    status & (SDHCI_INT_DATA_END | SDHCI_INT_ERROR_MASK));
+		}
+		return -1;
+	}
+	whyred_emmc_write32(base, SDHCI_INT_STATUS, SDHCI_INT_DATA_END);
+	whyred_emmc_write16(base, SDHCI_BLOCK_SIZE, old_block_size);
+	whyred_emmc_write16(base, SDHCI_BLOCK_COUNT, old_block_count);
+	whyred_emmc_write16(base, SDHCI_TRANSFER_MODE, old_transfer_mode);
+	return 0;
+}
+
+static void
+whyred_emmc_restore_signals(volatile uint8_t *base, uint32_t signal_enable)
+{
+	if (signal_enable == 0) {
+		return;
+	}
+	uint32_t pending = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+	uint32_t present = whyred_emmc_read32(base, SDHCI_PRESENT_STATE);
+	if (pending == 0 && (present & (SDHCI_PSTATE_CMD_INHIBIT |
+	    SDHCI_PSTATE_DATA_INHIBIT)) == 0) {
+		whyred_emmc_write32(base, SDHCI_SIGNAL_ENABLE, signal_enable);
+	} else {
+		printf("WHYRED EMMC: host signal mask kept after incomplete command int=0x%08x present=0x%08x\n",
+		    pending, present);
+	}
+}
+
+void
+whyred_emmc_pio_probe(void)
+{
+	vm_offset_t mapping = ml_io_map((vm_offset_t)WHYRED_SDCC1_HC_PHYS,
+	    WHYRED_SDCC1_HC_SIZE);
+	if (mapping == 0) {
+		printf("WHYRED EMMC: ml_io_map failed for SDCC1\n");
+		return;
+	}
+	volatile uint8_t *base = (volatile uint8_t *)(uintptr_t)mapping;
+	uint32_t present = whyred_emmc_read32(base, SDHCI_PRESENT_STATE);
+	uint16_t clock = whyred_emmc_read16(base, SDHCI_CLOCK_CONTROL);
+	uint8_t power = *(volatile uint8_t *)(base + SDHCI_POWER_CONTROL);
+	uint8_t host = *(volatile uint8_t *)(base + SDHCI_HOST_CONTROL);
+	uint32_t signal_enable = whyred_emmc_read32(base, SDHCI_SIGNAL_ENABLE);
+
+	printf("WHYRED EMMC: PIO probe present=0x%08x host=0x%02x power=0x%02x clock=0x%04x signal=0x%08x\n",
+	    present, (unsigned int)host, (unsigned int)power, clock, signal_enable);
+	if ((present & (SDHCI_PSTATE_CMD_INHIBIT | SDHCI_PSTATE_DATA_INHIBIT |
+	    SDHCI_PSTATE_DATA_AVAILABLE)) != 0 ||
+	    (present & SDHCI_PSTATE_CMD_LEVEL) == 0 ||
+	    (present & (SDHCI_PSTATE_DAT4_TO_DAT7 | SDHCI_PSTATE_DAT0_TO_DAT3)) !=
+	    (SDHCI_PSTATE_DAT4_TO_DAT7 | SDHCI_PSTATE_DAT0_TO_DAT3) ||
+	    (power & SDHCI_POWER_ENABLE) == 0 ||
+	    (clock & (SDHCI_CLOCK_CARD_ENABLE | SDHCI_CLOCK_INT_STABLE |
+	    SDHCI_CLOCK_INT_ENABLE)) != (SDHCI_CLOCK_CARD_ENABLE |
+	    SDHCI_CLOCK_INT_STABLE | SDHCI_CLOCK_INT_ENABLE)) {
+		printf("WHYRED EMMC: controller not idle/powered/clocked; no command sent\n");
+		return;
+	}
+
+	uint32_t stale = whyred_emmc_read32(base, SDHCI_INT_STATUS);
+	if (stale != 0) {
+		printf("WHYRED EMMC: pending status=0x%08x; no command sent\n", stale);
+		return;
+	}
+	if (signal_enable != 0) {
+		/* Poll completion instead of delivering an unhandled host IRQ. */
+		whyred_emmc_write32(base, SDHCI_SIGNAL_ENABLE, 0);
+	}
+
+	uint32_t card_status = 0;
+	uint16_t cmd13 = (SDHCI_CMD_SEND_STATUS << 8) |
+	    SDHCI_CMD_RESP_SHORT_CRC_INDEX;
+	if (whyred_emmc_command(base, WHYRED_EMMC_RCA << 16, cmd13,
+	    &card_status) != 0) {
+		printf("WHYRED EMMC: CMD13 did not complete; no reinit attempted\n");
+		whyred_emmc_restore_signals(base, signal_enable);
+		return;
+	}
+	uint32_t state = (card_status >> 9) & 0xf;
+	printf("WHYRED EMMC: CMD13 rca=%u response=0x%08x state=%u ready=%u\n",
+	    (unsigned int)WHYRED_EMMC_RCA, card_status, state,
+	    (card_status & WHYRED_EMMC_STATUS_READY) != 0);
+	if (state != WHYRED_EMMC_STATUS_TRANSFER ||
+	    (card_status & WHYRED_EMMC_STATUS_READY) == 0) {
+		printf("WHYRED EMMC: card not ready in Transfer state; no CMD8 sent\n");
+		whyred_emmc_restore_signals(base, signal_enable);
+		return;
+	}
+
+	uint8_t ext_csd[WHYRED_EXT_CSD_BYTES];
+	if (whyred_emmc_read_ext_csd(base, ext_csd) != 0) {
+		printf("WHYRED EMMC: EXT_CSD read failed; no media write issued\n");
+		whyred_emmc_restore_signals(base, signal_enable);
+		return;
+	}
+	uint32_t sectors = (uint32_t)ext_csd[212] |
+	    ((uint32_t)ext_csd[213] << 8) |
+	    ((uint32_t)ext_csd[214] << 16) |
+	    ((uint32_t)ext_csd[215] << 24);
+	printf("WHYRED EMMC: EXT_CSD read ok rev=%u card_type=0x%02x sec_count=%u\n",
+	    (unsigned int)ext_csd[192], (unsigned int)ext_csd[196], sectors);
+	printf("WHYRED EMMC: read-only metadata probe complete; no user sectors read or written\n");
+	whyred_emmc_restore_signals(base, signal_enable);
+}
+
+#else
+void
+whyred_emmc_pio_probe(void)
+{
+}
+#endif

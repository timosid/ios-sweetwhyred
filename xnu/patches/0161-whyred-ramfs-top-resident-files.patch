+/* Diagnostic names only: bounded printable ASCII, never file content. */
+static void
+ramfs_pressure_name(char *dst, size_t capacity, const char *src, size_t length)
+{
+	if (!capacity) return;
+	size_t i;
+	for (i = 0; i < length && i + 1 < capacity; i++) {
+		unsigned char c = (unsigned char)src[i];
+		dst[i] = c >= 0x20 && c <= 0x7e && c != '"' && c != '\\' ? (char)c : '?';
+	}
+	dst[i] = 0;
+}
 
